# HMAC key for signed download URLs. At least 16 characters.
# Generate one with: openssl rand -hex 32
# Leave this empty. A value published in git would be a known key.
FETCHR_PROXY_SECRET=

# Optional Turnstile secret. Leave empty to refuse requests over the rate limit.
TURNSTILE_SECRET=

# Optional Xiaohongshu escape hatch. Shared notes are served anonymously via
# the mobile share render, so this stays empty in normal operation. If that
# path ever closes, a signed-in web_session cookie restores access:
#   XHS_COOKIE=web_session=<value>
XHS_COOKIE=
