{
  "name": "fetchr",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platform/*",
    "bench"
  ],
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "check": "bun scripts/ci/check.ts",
    "test": "bun test",
    "typecheck": "bun scripts/ci/typecheck-workspaces.ts",
    "build": "bun run --cwd apps/web build",
    "deploy": "bun run --cwd apps/web deploy",
    "verify:fast": "bun run typecheck && bun run lint && bun test",
    "verify": "bun run verify:fast && bun run knip && bun run arch && bun run --cwd apps/web doctor",
    "knip": "knip",
    "arch": "bun run check",
    "test:e2e": "playwright test",
    "policy": "semgrep --config .verifier/semgrep --error .",
    "bench": "bun run bench/index.ts",
    "bundle:check": "bun run performance/bundle-budget.ts",
    "perf:smoke": "k6 run performance/k6/smoke.js",
    "perf:load": "k6 run performance/k6/load.js",
    "perf:soak": "k6 run performance/k6/soak.js",
    "compat": "bun run scripts/compat-check.ts",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "release:health": "bun run scripts/release/health-gate.ts",
    "release:promote": "bun run scripts/release/promote.ts",
    "release:rollback": "bun run scripts/release/rollback.ts"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "undici": "7.29.1",
    "tmp": "^0.2.7",
    "basic-ftp": "^6.2.1",
    "uuid": "^11.1.1",
    "satori": {
      "fflate": "0.7.5"
    },
    "@shuding/opentype.js": {
      "fflate": "0.7.5"
    },
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.2.22",
    "fast-check": "^4.10.2",
    "knip": "^6.39.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "7.0.2"
  },
  "cloudflare": {
    "bindings": {
      "FETCHR_PROXY_SECRET": {
        "description": "HMAC key for signed download URLs. Generate one with `openssl rand -hex 32`. Use at least 16 characters, and a different value for every deploy. Leave the example file empty."
      },
      "TURNSTILE_SECRET": {
        "description": "Optional Cloudflare Turnstile secret. Leave it empty to refuse requests that go over the rate limit."
      }
    }
  }
}
