{
  "name": "@fetchr/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lhci": "bun scripts/preview-compressed.mjs",
    "lhci": "lhci autorun",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-stone": "0.6.3",
    "@fetchr/core": "workspace:*",
    "@fetchr/delivery": "workspace:*",
    "@fetchr/media-browser": "workspace:*",
    "@fetchr/platform-bilibili": "workspace:*",
    "@fetchr/platform-douyin": "workspace:*",
    "@fetchr/platform-instagram": "workspace:*",
    "@fetchr/platform-kuaishou": "workspace:*",
    "@fetchr/platform-tiktok": "workspace:*",
    "@fetchr/platform-twitter": "workspace:*",
    "@fetchr/platform-xiaohongshu": "workspace:*",
    "@fetchr/platform-youtube": "workspace:*",
    "@fontsource/figtree": "^5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "effect": "4.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.6.3",
    "@astryxdesign/cli": "0.6.3",
    "@babel/core": "7.29.6",
    "@cloudflare/vite-plugin": "1.60.2",
    "@lhci/cli": "^0.15",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "5.9.2",
    "vite": "8.1.3",
    "wrangler": "4.141.0"
  },
  "browserslist": [
    "last 1 Chrome version"
  ],
  "cloudflare": {
    "bindings": {
      "FETCHR_PROXY_SECRET": {
        "description": "HMAC key for signed download URLs. Generate one with `openssl rand -hex 32`. Use at least 16 characters, and a different value for every deploy. Leave the example file empty."
      },
      "TURNSTILE_SECRET": {
        "description": "Optional Cloudflare Turnstile secret. Leave it empty to refuse requests that go over the rate limit."
      }
    }
  }
}
